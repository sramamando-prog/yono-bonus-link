rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /app_logos/{fileName} {
      // Anyone can read and download logos
      allow read: if true;

      // Only authorized admin (akashramamando@gmail.com) can upload/write
      // Enforce file size <= 5MB and allowed image types (JPG, PNG, WEBP)
      allow write: if request.auth != null &&
                      request.auth.token.email == "akashramamando@gmail.com" &&
                      request.resource.size <= 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');

      // Only authorized admin can delete
      allow delete: if request.auth != null &&
                       request.auth.token.email == "akashramamando@gmail.com";
    }
  }
}
